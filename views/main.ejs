<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Placement Portal
    </title>

    <link rel="stylesheet"
        href="/css/main.css">

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >
</head>

<body>

    <div class="background"></div>

    <!-- Navbar -->

    <nav class="navbar">

        <a href="/" class="logo">
            Placement Portal
        </a>

        <div class="nav-links">

            <a href="#features">
                Features
            </a>

            <a href="#process">
                How It Works
            </a>

            <a href="#about">
                About
            </a>

        </div>

        <a
            href="/login-selection"
            class="login-btn"
        >
            Login
        </a>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <div class="hero-badge">
            Campus Placements. Simplified.
        </div>

        <h1>
            One platform.
            <br>

            <span>
                Every placement opportunity.
            </span>
        </h1>

        <p>
            A modern placement management platform that connects
            students and placement officers through a streamlined,
            transparent and efficient recruitment experience.
        </p>

        <div class="hero-actions">

            <a
                href="/login-selection"
                class="primary-btn"
            >
                Get Started
                <span>→</span>
            </a>

            <a
                href="#features"
                class="secondary-btn"
            >
                Explore Features
            </a>

        </div>

        <div class="hero-dashboard">

            <div class="dashboard-top">

                <div>

                    <span class="small-label">
                        Placement Dashboard
                    </span>

                    <h2>
                        Your career journey,
                        all in one place.
                    </h2>

                </div>

                <div class="dashboard-status">

                    <span class="status-dot"></span>

                    Placement Season Active

                </div>

            </div>

            <div class="mini-stats">

                <div class="mini-card">

                    <span>
                        Eligible Drives
                    </span>

                    <strong>
                        12
                    </strong>

                </div>

                <div class="mini-card">

                    <span>
                        Applications
                    </span>

                    <strong>
                        06
                    </strong>

                </div>

                <div class="mini-card">

                    <span>
                        Shortlisted
                    </span>

                    <strong>
                        03
                    </strong>

                </div>

                <div class="mini-card">

                    <span>
                        Selected
                    </span>

                    <strong>
                        01
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- About -->

    <section
        class="about-section"
        id="about"
    >

        <div class="section-label">
            Built for campus recruitment
        </div>

        <h2>
            Placement management shouldn't be complicated.
        </h2>

        <p>
            The Placement Portal centralizes student profiles,
            resumes, placement drives, eligibility checks and
            application tracking into one easy-to-use system.
        </p>

    </section>


    <!-- Student Features -->

    <section
        class="feature-section"
        id="features"
    >

        <div class="section-heading">

            <span>
                For Students
            </span>

            <h2>
                Everything you need to move
                your career forward.
            </h2>

        </div>

        <div class="feature-grid">

            <div class="feature-card large-card">

                <div class="feature-icon">
                    👤
                </div>

                <h3>
                    Build Your Profile
                </h3>

                <p>
                    Maintain academic information,
                    skills, personal details and placement
                    information from one profile.
                </p>

            </div>

            <div class="feature-card">

                <div class="feature-icon">
                    📄
                </div>

                <h3>
                    Resume Management
                </h3>

                <p>
                    Upload and maintain your latest resume
                    for upcoming placement drives.
                </p>

            </div>

            <div class="feature-card">

                <div class="feature-icon">
                    🚀
                </div>

                <h3>
                    Eligible Drives
                </h3>

                <p>
                    Automatically discover placement drives
                    based on CGPA, branch and eligibility criteria.
                </p>

            </div>

            <div class="feature-card">

                <div class="feature-icon">
                    📊
                </div>

                <h3>
                    Application Tracking
                </h3>

                <p>
                    Track application status from applied
                    to shortlisted, selected or rejected.
                </p>

            </div>

        </div>

    </section>


    <!-- Admin Features -->

    <section class="feature-section admin-feature-section">

        <div class="section-heading">

            <span>
                For TPO / Admin
            </span>

            <h2>
                Powerful tools for managing
                the entire placement process.
            </h2>

        </div>

        <div class="feature-grid">

            <div class="feature-card">

                <div class="feature-icon">
                    🎓
                </div>

                <h3>
                    Manage Students
                </h3>

                <p>
                    View academic records, resumes,
                    placement status and complete
                    student information.
                </p>

            </div>

            <div class="feature-card">

                <div class="feature-icon">
                    🏢
                </div>

                <h3>
                    Placement Drives
                </h3>

                <p>
                    Create, update and monitor
                    recruitment drives and eligibility rules.
                </p>

            </div>

            <div class="feature-card">

                <div class="feature-icon">
                    📋
                </div>

                <h3>
                    Application Management
                </h3>

                <p>
                    Review applicants, filter applications
                    and update selection results.
                </p>

            </div>

            <div class="feature-card large-card">

                <div class="feature-icon">
                    📈
                </div>

                <h3>
                    Placement Insights
                </h3>

                <p>
                    Monitor student participation,
                    active drives and placement statistics
                    through a centralized dashboard.
                </p>

            </div>

        </div>

    </section>


    <!-- How It Works -->

    <section
        class="process-section"
        id="process"
    >

        <div class="section-heading center">

            <span>
                Simple Workflow
            </span>

            <h2>
                From profile to placement.
            </h2>

        </div>

        <div class="process-grid">

            <div class="process-card">

                <div class="step-number">
                    01
                </div>

                <h3>
                    Create Profile
                </h3>

                <p>
                    Students register and complete
                    academic and personal information.
                </p>

            </div>

            <div class="process-line"></div>

            <div class="process-card">

                <div class="step-number">
                    02
                </div>

                <h3>
                    Discover Drives
                </h3>

                <p>
                    Eligible placement drives are shown
                    automatically based on student profile.
                </p>

            </div>

            <div class="process-line"></div>

            <div class="process-card">

                <div class="step-number">
                    03
                </div>

                <h3>
                    Apply
                </h3>

                <p>
                    Students apply directly through
                    the placement portal.
                </p>

            </div>

            <div class="process-line"></div>

            <div class="process-card">

                <div class="step-number">
                    04
                </div>

                <h3>
                    Track Results
                </h3>

                <p>
                    Application status is updated
                    by the placement administrator.
                </p>

            </div>

        </div>

    </section>


    <!-- Statistics -->

    <section class="stats-section">

        <div class="stat">

            <h2>
                1000+
            </h2>

            <p>
                Students
            </p>

        </div>

        <div class="stat">

            <h2>
                100+
            </h2>

            <p>
                Placement Drives
            </p>

        </div>

        <div class="stat">

            <h2>
                50+
            </h2>

            <p>
                Recruiters
            </p>

        </div>

        <div class="stat">

            <h2>
                500+
            </h2>

            <p>
                Placements
            </p>

        </div>

    </section>


    <!-- CTA -->

    <section class="cta-section">

        <div class="cta-card">

            <div class="cta-glow"></div>

            <span>
                Start your placement journey
            </span>

            <h2>
                One portal.
                <br>
                Endless opportunities.
            </h2>

            <p>
                Access placement opportunities,
                manage applications and track your progress
                through one unified platform.
            </p>

            <a
                href="/login-selection"
                class="primary-btn"
            >
                Enter Placement Portal
                <span>→</span>
            </a>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <div class="footer-content">

            <div>

                <div class="footer-logo">
                    Placement Portal
                </div>

                <p>
                    Making campus placements
                    simpler, smarter and more transparent.
                </p>

            </div>

            <div class="footer-links">

                <a href="/">
                    Home
                </a>

                <a href="#features">
                    Features
                </a>

                <a href="#process">
                    How It Works
                </a>

                <a href="/login-selection">
                    Login
                </a>

            </div>

        </div>

        <div class="footer-bottom">

            <p>
                © 2026 Placement Management System
            </p>

            <p>
                Developed by Lokesh
            </p>

        </div>

    </footer>

</body>

</html>