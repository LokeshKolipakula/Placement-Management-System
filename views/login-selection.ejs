<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Login | Placement Portal</title>
    <link rel="stylesheet" href="/css/login-selection.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="background"></div>

    <nav>
        <div class="logo">Placement Portal</div>
        <a href="/" class="home-btn">Home</a>
    </nav>

    <section class="container">

        <h1>Welcome Back</h1>
        <p class="subtitle">
            Choose your portal to continue
        </p>

        <div class="card-container">

            <div class="login-card">
                <div class="icon">🎓</div>

                <h2>Student Portal</h2>

                <p>
                    Manage profile, upload resume,
                    apply for drives and track applications.
                </p>

                <a href="/student-login" class="card-btn">
                    Student Login
                </a>
            </div>

            <div class="login-card">
                <div class="icon">💼</div>

                <h2>TPO / Admin Portal</h2>

                <p>
                    Manage students, companies,
                    placement drives and results.
                </p>

                <a href="/admin-login" class="card-btn">
                    Admin Login
                </a>
            </div>

        </div>

    </section>

</body>
</html>