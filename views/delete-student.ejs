<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Delete Student</title>

    <link rel="stylesheet" href="/css/delete-student.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

</head>

<body>

<div class="background"></div>

<nav class="navbar">

    <div class="logo">
        Placement Portal
    </div>

    <a href="/admin/manage-students" class="back-btn">
        ← Back
    </a>

</nav>

<div class="container">

    <div class="delete-card">

        <div class="warning-icon">
            ⚠️
        </div>

        <h1>
            Delete Student
        </h1>

        <p>
            Are you sure you want to delete this student?
        </p>

        <div class="student-info">

            <h3>
                <%= student.name %>
            </h3>

            <p>
                <%= student.regNo %>
            </p>

            <p>
                <%= student.email %>
            </p>

        </div>

        <form
            action="/admin/delete-student/<%= student._id %>"
            method="POST"
        >

            <button
                type="submit"
                class="delete-btn"
            >
                Delete Student
            </button>

        </form>

    </div>

</div>

</body>
</html>