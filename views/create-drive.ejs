<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Placement Drive</title>

    <link rel="stylesheet" href="/css/create-drive.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

</head>

<body>

<div class="background"></div>

<nav class="navbar">

    <div class="logo">
        Placement Portal
    </div>

    <a href="/admin-dashboard" class="back-btn">
        Dashboard
    </a>

</nav>

<div class="container">

    <div class="page-header">

        <div class="header-icon">
            🚀
        </div>

        <div>

            <h1>Create Placement Drive</h1>

            <p>
                Add a new company recruitment drive
            </p>

        </div>

    </div>

    <form
        action="/admin/create-drive"
        method="POST"
        class="drive-form"
    >

        <div class="form-card">

            <h2>Company Information</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Company Name</label>

                    <input
                        type="text"
                        name="companyName"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Role</label>

                    <input
                        type="text"
                        name="role"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Package (LPA)</label>

                    <input
                        type="number"
                        step="0.01"
                        name="package"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Location</label>

                    <input
                        type="text"
                        name="location"
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Eligibility Criteria</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Eligible Branches</label>

                    <input
                        type="text"
                        name="eligibleBranches"
                        placeholder="CSE,ECE,IT"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Minimum CGPA</label>

                    <input
                        type="number"
                        step="0.01"
                        name="minCGPA"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Maximum Backlogs</label>

                    <input
                        type="number"
                        name="maxBacklogs"
                        required
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Drive Schedule</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Drive Date</label>

                    <input
                        type="date"
                        name="driveDate"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Application Deadline</label>

                    <input
                        type="date"
                        name="applicationDeadline"
                        required
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Job Description</h2>

            <div class="input-group">

                <label>Description</label>

                <textarea
                    name="description"
                    rows="6"
                    placeholder="Enter company requirements, selection process, skills required..."
                ></textarea>

            </div>

        </div>

        <button
            type="submit"
            class="create-btn"
        >
            Create Drive
        </button>

    </form>

</div>

</body>
</html>