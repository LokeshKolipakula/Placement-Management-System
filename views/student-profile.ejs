<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete Profile</title>

    <link rel="stylesheet" href="/css/student-profile.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body>

    <div class="background"></div>

    <nav class="navbar">

        <div class="logo">
            Placement Portal
        </div>

        <a href="/student-dashboard" class="back-btn">
            Dashboard
        </a>

    </nav>

    <div class="container">

        <div class="profile-header">

            <div class="profile-icon">
                👨‍🎓
            </div>

            <div>

                <h1>
                    Complete Profile
                </h1>

                <p>
                    Keep your placement profile updated
                </p>

            </div>

        </div>

        <% if(success){ %>

            <div class="success-box">
                <%= success %>
            </div>

            <% } %>

                <form action="/student/profile" method="POST">

                    <div class="profile-card">

                        <h2>Basic Information</h2>

                        <div class="grid">

                            <div class="input-group">
                                <label>Full Name</label>
                                <input type="text" name="name" value="<%= student.name || '' %>">
                            </div>

                            <div class="input-group">
                                <label>Registration Number</label>
                                <input type="text" value="<%= student.regNo || '' %>" readonly>
                            </div>

                            <div class="input-group">
                                <label>Email</label>
                                <input type="email" value="<%= student.email || '' %>" readonly>
                            </div>

                            <div class="input-group">
                                <label>Branch</label>
                                <input type="text" name="branch" value="<%= student.branch || '' %>">
                            </div>

                        </div>

                    </div>

                    <div class="profile-card">

                        <h2>Academic Information</h2>

                        <div class="grid">

                            <div class="input-group">
                                <label>CGPA</label>
                                <input type="number" step="0.01" name="cgpa" value="<%= student.cgpa || '' %>">
                            </div>

                            <div class="input-group">
                                <label>10th Percentage</label>
                                <input type="number" step="0.01" name="tenthPercentage"
                                    value="<%= student.tenthPercentage || '' %>">
                            </div>

                            <div class="input-group">
                                <label>12th Percentage</label>
                                <input type="number" step="0.01" name="twelfthPercentage"
                                    value="<%= student.twelfthPercentage || '' %>">
                            </div>

                            <div class="input-group">
                                <label>Current Backlogs</label>
                                <input type="number" name="backlogs" value="<%= student.backlogs || 0 %>">
                            </div>

                        </div>

                    </div>

                    <div class="profile-card">

                        <h2>Personal Information</h2>

                        <div class="grid">

                            <div class="input-group">
                                <label>Phone Number</label>
                                <input type="text" name="phone" value="<%= student.phone || '' %>">
                            </div>

                            <div class="input-group">
                                <label>Gender</label>

                                <select name="gender">

                                    <option value="">Select</option>

                                    <option value="Male" <%=student.gender==='Male' ? 'selected' : '' %>>
                                        Male
                                    </option>

                                    <option value="Female" <%=student.gender==='Female' ? 'selected' : '' %>>
                                        Female
                                    </option>

                                </select>

                            </div>

                            <div class="input-group">
                                <label>Date of Birth</label>

                                <input type="date" name="dateOfBirth"
                                    value="<%= student.dateOfBirth ? student.dateOfBirth.toISOString().split('T')[0] : '' %>">
                            </div>

                        </div>

                        <div class="input-group address-group">

                            <label>Address</label>

                            <textarea name="address" rows="4"><%= student.address || '' %></textarea>

                        </div>

                    </div>

                    <div class="profile-card">

                        <h2>Skills</h2>

                        <div class="input-group">

                            <label>
                                Skills (Comma Separated)
                            </label>

                            <textarea name="skills"
                                rows="4"><%= student.skills ? student.skills.join(', ') : '' %></textarea>

                        </div>

                    </div>

                    <button class="save-btn" type="submit">
                        Save Profile
                    </button>

                </form>

    </div>

</body>

</html>