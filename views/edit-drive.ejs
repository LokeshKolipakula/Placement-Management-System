<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Drive</title>

    <link rel="stylesheet" href="/css/edit-drive.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

</head>

<body>

<div class="background"></div>

<nav class="navbar">

    <div class="logo">
        Placement Portal
    </div>

    <a href="/admin/drives" class="back-btn">
        ← Back to Drives
    </a>

</nav>

<div class="container">

    <div class="page-header">

        <div class="header-icon">
            ✏️
        </div>

        <div>

            <h1>Edit Drive</h1>

            <p>
                Update drive information and eligibility criteria.
            </p>

        </div>

    </div>

    <div class="status-card">

        <span>Status</span>

        <% if(drive.status === "Active"){ %>

            <div class="status active">
                Active
            </div>

        <% } else { %>

            <div class="status closed">
                Closed
            </div>

        <% } %>

    </div>

    <form
        action="/admin/edit-drive/<%= drive._id %>"
        method="POST"
        class="drive-form"
    >

        <div class="form-card">

            <h2>Company Information</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Company Name</label>

                    <input
                        type="text"
                        name="companyName"
                        value="<%= drive.companyName %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Role</label>

                    <input
                        type="text"
                        name="role"
                        value="<%= drive.role %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Package (LPA)</label>

                    <input
                        type="number"
                        step="0.01"
                        name="package"
                        value="<%= drive.package %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Location</label>

                    <input
                        type="text"
                        name="location"
                        value="<%= drive.location %>"
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Eligibility Criteria</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Eligible Branches</label>

                    <input
                        type="text"
                        name="eligibleBranches"
                        value="<%= drive.eligibleBranches.join(', ') %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Minimum CGPA</label>

                    <input
                        type="number"
                        step="0.01"
                        name="minCGPA"
                        value="<%= drive.minCGPA %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Maximum Backlogs</label>

                    <input
                        type="number"
                        name="maxBacklogs"
                        value="<%= drive.maxBacklogs %>"
                        required
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Schedule</h2>

            <div class="grid">

                <div class="input-group">

                    <label>Drive Date</label>

                    <input
                        type="date"
                        name="driveDate"
                        value="<%= drive.driveDate.toISOString().split('T')[0] %>"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Application Deadline</label>

                    <input
                        type="date"
                        name="applicationDeadline"
                        value="<%= drive.applicationDeadline.toISOString().split('T')[0] %>"
                        required
                    >

                </div>

            </div>

        </div>

        <div class="form-card">

            <h2>Description</h2>

            <textarea
                name="description"
                rows="6"
            ><%= drive.description %></textarea>

        </div>

        <div class="form-card">

            <h2>Status</h2>

            <select name="status">

                <option
                    value="Active"
                    <%= drive.status === "Active" ? "selected" : "" %>
                >
                    Active
                </option>

                <option
                    value="Closed"
                    <%= drive.status === "Closed" ? "selected" : "" %>
                >
                    Closed
                </option>

            </select>

        </div>

        <button
            type="submit"
            class="save-btn"
        >
            Save Changes
        </button>

    </form>

</div>

</body>
</html>